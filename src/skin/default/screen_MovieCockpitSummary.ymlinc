screen:
  name: "MovieCockpitSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - ePixmap:
        alphatest: "on"
        pixmap: "~/../images/display_bg.png"
        position: "0,0"
        size: "e,e"
        zPosition: "-10"
    - widget:
        font: "FdLcD;36"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "e-3,e-80"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceName"
              text: "Name"
    - widget:
        font: "FdLcD;60"
        halign: "left"
        position: "0,e-80"
        render: "Label"
        size: "300,80"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "FileSize"
    - widget:
        font: "FdLcD;60"
        halign: "right"
        position: "300,e-80"
        render: "Label"
        size: "92,80"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "MovieDuration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
