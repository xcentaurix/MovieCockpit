screen:
  name: "CockpitPlayerSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - ePixmap:
        alphatest: "on"
        pixmap: "~/../images/display_bg.png"
        position: "0,0"
        size: "e,e"
        zPosition: "-10"
    - widget:
        font: "FdLcD;50"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "395,125"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventName"
              text: "Name"
    - widget:
        alphatest: "blend"
        borderWidth: "1"
        foregroundColor: "yellow"
        position: "0,140"
        render: "Progress"
        size: "395,15"
        source: "parent.Service"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        borderWidth: "1"
        foregroundColor: "darkgrey"
        position: "0,140"
        render: "Progress"
        size: "395,15"
        source: "parent.Service"
        transparent: "1"
        zPosition: "3"
        children:
          - convert:
              type: "COCBeforeTSPosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        borderWidth: "1"
        foregroundColor: "red"
        position: "0,140"
        render: "Progress"
        size: "395,15"
        source: "parent.Service"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "COCRecordPosition"
              text: "Position"
    - widget:
        font: "FdLcD;60"
        halign: "left"
        position: "0,160"
        render: "Label"
        size: "230,80"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "EndTime,ShowNoSeconds"
    - widget:
        font: "FdLcD;60"
        halign: "right"
        position: "240,160"
        render: "Label"
        size: "150,80"
        source: "parent.Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Remaining,ShowNoSeconds"
