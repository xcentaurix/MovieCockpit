screen:
  name: "RecordingInfo"
  position: "center,center"
  size: "1920,1080"
  transparent: "0"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        enableWrapAround: "1"
        position: "20,100"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1880,865"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContent"
              cell:
                itemHeight: 40
                fonts:
                  - "Regular;30"
                fields:
                  - text:
                      position: "5,0"
                      size: "360,40"
                      flags: RT_VALIGN_CENTER
                      value: 0
                  - text:
                      position: "420,0"
                      size: "1360,40"
                      flags: RT_VALIGN_CENTER
                      value: 1
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
