screen:
  name: "MovieCockpit"
  position: "center,center"
  size: "1920,1080"
  transparent: "0"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "#00000000"
        pixmap: "~/../images/sort.svg"
        position: "38,80"
        scale: "scale"
        size: "38,38"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        halign: "left"
        name: "sort_mode"
        position: "83,80"
        size: "563,38"
        transparent: "1"
        valign: "center"
    - ePixmap:
        alphatest: "blend"
        backgroundColor: "#00000000"
        pixmap: "~/../images/hardisk.svg"
        position: "563,80"
        scale: "scale"
        size: "38,38"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        halign: "left"
        position: "608,80"
        render: "Label"
        size: "620,38"
        source: "DiskSpace"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCDiskSpaceInfo"
              text: "SpaceInfo"
    - widget:
        alphatest: "blend"
        name: "pic_loading"
        position: "559,421"
        size: "100,100"
        zPosition: "3"
    - widget:
        backgroundColorSelected: "keyBlue"
        enableWrapAround: "1"
        position: "30,135"
        render: "Listbox"
        scrollbarMode: "showAlways"
        scrollbarWidth: "5"
        size: "1200,855"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContentEx"
              cell:
                itemHeight: 45
                fonts:
                  - "Regular;32"
                  - "Regular;30"
                  - "Regular;28"
                fields:
                  - icon:
                      position: "0,5"
                      size: "35,35"
                      flags: BT_SCALE
                      value: 23
                  - icon:
                      position: "50,5"
                      size: "55,35"
                      flags: BT_SCALE
                      value: 24
                  - text:
                      position: "120,0"
                      size: "e-485,45"
                      font: "Regular;30"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 20
                      color: {call: MultiContentTemplateColor, args: [25]}
                      color_sel: {call: MultiContentTemplateColor, args: [26]}
                  - progress:
                      position: "e-350,15"
                      size: "90,14"
                      value: -22
                      borderWidth: 1
                      foreColor: "#bababa"
                      foreColorSelected: "#ffffff"
                      backColor: "progressBG"
                      backColorSelected: "progressBG"
                  - progress:
                      position: "e-350,15"
                      size: "90,14"
                      value: -27
                      borderWidth: 1
                      foreColor: "#ff1616"
                      foreColorSelected: "#ff3838"
                      backColor: "progressBG"
                      backColorSelected: "progressBG"
                  - progress:
                      position: "e-350,15"
                      size: "90,14"
                      value: -28
                      borderWidth: 1
                      foreColor: "#cccc00"
                      foreColorSelected: "#ffff00"
                      backColor: "progressBG"
                      backColorSelected: "progressBG"
                  - text:
                      position: "e-245,0"
                      size: "230,45"
                      font: "Regular;28"
                      flags: RT_HALIGN_RIGHT|RT_VALIGN_CENTER
                      value: 21
                      color: {call: MultiContentTemplateColor, args: [25]}
                      color_sel: {call: MultiContentTemplateColor, args: [26]}
    - widget:
        alphatest: "blend"
        backgroundColor: "secondBG"
        position: "1260,135"
        render: "COCCover"
        size: "630,375"
        source: "Service"
        transparent: "1"
    - widget:
        font: "$FB_medium"
        position: "1270,515"
        render: "Label"
        size: "620,80"
        source: "Service"
        transparent: "1"
        valign: "center"
        zPosition: "2"
        children:
          - convert:
              type: "COCEventName"
              text: "Name"
    - widget:
        font: "$FB_small"
        position: "1270,585"
        render: "Label"
        size: "280,34"
        source: "Service"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceTime"
              text: "Duration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
    - widget:
        font: "$FB_medium"
        noWrap: "1"
        position: "1270,635"
        render: "Label"
        size: "630,40"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventName"
              text: "Description"
    - widget:
        font: "$FR_small"
        options: "movetype=swimming, direction=top, startpoint=0, startdelay=4000, wrap=1, always=0, repeat=1, oneshot=1, steptime=100"
        position: "1270,635"
        render: "COCRunningText"
        size: "630,345"
        size2: "630,290"
        source: "Service"
        transparent: "1"
        children:
          - convert:
              type: "COCEventName"
              text: "ShortAndExtendedDescription"
    - eLabel:
        backgroundColor: "barBG"
        position: "0,1025"
        size: "1920,55"
        zPosition: "0"
    - eLabel:
        backgroundColor: "separator"
        position: "0,1025"
        size: "1920,2"
        zPosition: "1"
    - widget:
        font: "$FR_medium"
        foregroundColor: "grey"
        halign: "center"
        name: "level"
        position: "0,1025"
        size: "96,55"
        transparent: "1"
        valign: "center"
        zPosition: "2"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
