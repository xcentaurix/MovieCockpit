screen:
  name: "CockpitPlayer"
  backgroundColor: "secondBG"
  position: "150,900"
  size: "1620,150"
  title: "CockpitPlayer"
  children:
    - xmlinc:
        file: "screenpart_fonts.ymlinc"
    - widget:
        backgroundColor: "secondBG"
        borderColor: "black"
        borderWidth: "2"
        font: "$FR_big"
        foregroundColor: "white"
        halign: "center"
        position: "c-624,6"
        render: "Label"
        size: "1248,74"
        source: "Service"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "COCEventName"
              text: "Name"
    - eLabel:
        backgroundColor: "sliderBG"
        position: "42,87"
        size: "1536,12"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        foregroundColor: "yellow"
        position: "42,87"
        render: "Progress"
        size: "1536,12"
        source: "Service"
        transparent: "1"
        zPosition: "5"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        foregroundColor: "darkgrey"
        position: "42,87"
        render: "Progress"
        size: "1536,12"
        source: "Service"
        transparent: "1"
        zPosition: "6"
        children:
          - convert:
              type: "COCBeforeTSPosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        foregroundColor: "red"
        position: "42,87"
        render: "Progress"
        size: "1536,12"
        source: "Service"
        transparent: "1"
        zPosition: "4"
        children:
          - convert:
              type: "COCRecordPosition"
              text: "Position"
    - widget:
        backgroundColor: "secondBG"
        borderColor: "black"
        borderWidth: "2"
        font: "$FR_medium"
        foregroundColor: "white"
        halign: "left"
        position: "42,46"
        render: "Label"
        size: "135,37"
        source: "Service"
        valign: "center"
        zPosition: "4"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position,Negate"
    - widget:
        backgroundColor: "secondBG"
        borderColor: "black"
        borderWidth: "2"
        font: "$FR_medium"
        foregroundColor: "white"
        halign: "right"
        position: "1402,46"
        render: "Label"
        size: "175,37"
        source: "Service"
        valign: "center"
        zPosition: "4"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Remaining"
    - widget:
        alphatest: "on"
        pixmap: "~/../images/rec.png"
        position: "1590,79"
        render: "Pixmap"
        size: "30,30"
        source: "session.RecordState"
        zPosition: "3"
        children:
          - convert:
              type: "ConditionalShowHide"
    - widget:
        backgroundColor: "secondBG"
        borderWidth: "2"
        font: "$FR_medium"
        foregroundColor: "white"
        halign: "right"
        noWrap: "1"
        position: "1428,4"
        render: "Label"
        size: "150,37"
        source: "Service"
        valign: "center"
        zPosition: "1"
        children:
          - convert:
              type: "COCServicePosition"
              text: "EndTime,ShowNoSeconds"
    - widget:
        font: "$FB_small"
        foregroundColor: "white"
        halign: "center"
        position: "c-109,105"
        render: "Label"
        size: "219,31"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Length"
    - widget:
        alphatest: "on"
        pixmap: "~/../images/ico_dolby_on.png"
        position: "1467,107"
        render: "Pixmap"
        size: "50,32"
        source: "Service"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsMultichannel"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "on"
        pixmap: "~/images/ico_format_hd.png"
        position: "1518,107"
        render: "Pixmap"
        size: "60,32"
        source: "Service"
        zPosition: "4"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsHD"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "on"
        pixmap: "~/images/ico_format_16_9.png"
        position: "1518,107"
        render: "Pixmap"
        size: "60,32"
        source: "Service"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsSDAndWidescreen"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "on"
        pixmap: "~/images/ico_format_4_3.png"
        position: "1518,107"
        render: "Pixmap"
        size: "60,32"
        source: "Service"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsSDAndNotWidescreen"
          - convert:
              type: "ConditionalShowHide"
