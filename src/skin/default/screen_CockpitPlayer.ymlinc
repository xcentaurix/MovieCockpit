- screen:
    backgroundColor: "transparent"
    name: "CockpitPlayer"
    position: "center,center"
    size: "1920,1080"
    children:
      - ePixmap:
          alphatest: "blend"
          pixmap: "~/../images/player_bg_gradient.png"
          position: "0,860"
          size: "1920,220"
          zPosition: "-1"
      - widget:
          font: "Regular;26"
          foregroundColor: "white"
          halign: "center"
          position: "1830,1005"
          render: "FixedLabel"
          size: "60,60"
          source: "session.CurrentService"
          text: "UHD"
          transparent: "1"
          valign: "center"
          zPosition: "2"
          children:
            - convert:
                type: "COCServiceInfo"
                text: "VideoWidth"
            - convert:
                type: "ValueRange"
                text: "2160,4320"
            - convert:
                type: "ConditionalShowHide"
      - widget:
          font: "Regular;26"
          foregroundColor: "white"
          halign: "center"
          position: "1830,1005"
          render: "FixedLabel"
          size: "60,60"
          source: "session.CurrentService"
          text: "FHD"
          transparent: "1"
          valign: "center"
          zPosition: "2"
          children:
            - convert:
                type: "COCServiceInfo"
                text: "VideoWidth"
            - convert:
                type: "ValueRange"
                text: "1920,2159"
            - convert:
                type: "ConditionalShowHide"
      - widget:
          font: "Regular;26"
          foregroundColor: "white"
          halign: "center"
          position: "1830,1005"
          render: "FixedLabel"
          size: "60,60"
          source: "session.CurrentService"
          text: "HD"
          transparent: "1"
          valign: "center"
          zPosition: "2"
          children:
            - convert:
                type: "COCServiceInfo"
                text: "VideoWidth"
            - convert:
                type: "ValueRange"
                text: "1280,1919"
            - convert:
                type: "ConditionalShowHide"
      - widget:
          font: "Regular;26"
          foregroundColor: "white"
          halign: "center"
          position: "1830,1005"
          render: "FixedLabel"
          size: "60,60"
          source: "session.CurrentService"
          text: "qHD"
          transparent: "1"
          valign: "center"
          zPosition: "2"
          children:
            - convert:
                type: "COCServiceInfo"
                text: "VideoWidth"
            - convert:
                type: "ValueRange"
                text: "960,1279"
            - convert:
                type: "ConditionalShowHide"
      - widget:
          font: "Regular;26"
          foregroundColor: "white"
          halign: "center"
          position: "1748,1005"
          render: "FixedLabel"
          size: "60,60"
          source: "session.CurrentService"
          text: "16:9"
          transparent: "1"
          valign: "center"
          zPosition: "1"
          children:
            - convert:
                type: "COCServiceInfo"
                text: "IsWidescreen"
            - convert:
                type: "ConditionalShowHide"
      - widget:
          path: "/usr/lib/enigma2/python/Plugins/SystemPlugins/ComponentsCockpit/skin/images/"
          position: "49,1019"
          render: "AudioIcon"
          size: "79,35"
          source: "session.CurrentService"
          zPosition: "2"
          children:
            - convert:
                type: "VAudioInfo"
                text: "AudioIcon"
      - widget:
          font: "Regular;26"
          foregroundColor: "white"
          halign: "center"
          position: "150,1013"
          render: "Label"
          size: "368,45"
          source: "session.CurrentService"
          transparent: "1"
          valign: "center"
          zPosition: "2"
          children:
            - convert:
                type: "COCServiceInfo"
                text: "VideoInfo"
      - widget:
          font: "Regular;34"
          halign: "right"
          position: "600,1020"
          render: "Label"
          size: "225,41"
          source: "Service"
          transparent: "1"
          children:
            - convert:
                type: "COCServicePosition"
                text: "Position,Negate"
      - widget:
          font: "Regular;41"
          halign: "center"
          position: "863,1016"
          render: "Label"
          size: "195,41"
          source: "Service"
          transparent: "1"
          children:
            - convert:
                type: "COCMovieInfo"
                text: "MovieDuration"
            - convert:
                type: "ClockToText"
                text: "InMinutes"
      - widget:
          font: "Regular;34"
          halign: "left"
          position: "1099,1020"
          render: "Label"
          size: "225,41"
          source: "Service"
          transparent: "1"
          children:
            - convert:
                type: "COCServicePosition"
                text: "Remaining"
      - ePixmap:
          name: "player_icon"
          pixmap: "~/../images/player.svg"
          position: "30,893"
          size: "60,60"
          zPosition: "2"
      - widget:
          font: "Regular;42"
          noWrap: "1"
          position: "105,900"
          render: "Label"
          size: "1600,50"
          source: "Service"
          transparent: "1"
          children:
            - convert:
                type: "COCEventName"
                text: "Name"
      - widget:
          font: "Bold;38"
          halign: "center"
          position: "1770,900"
          render: "Label"
          size: "120,53"
          source: "Service"
          transparent: "1"
          valign: "center"
          children:
            - convert:
                type: "COCServicePosition"
                text: "EndTime,ShowNoSeconds"
      - eLabel:
          backgroundColor: "backgroundLight"
          position: "30,971"
          size: "1860,10"
          zPosition: "0"
      - widget:
          alphatest: "blend"
          foregroundColor: "yellow"
          position: "30,971"
          render: "Progress"
          size: "1860,10"
          source: "Service"
          transparent: "1"
          zPosition: "2"
          children:
            - convert:
                type: "COCServicePosition"
                text: "Position"
      - widget:
          alphatest: "blend"
          foregroundColor: "darkgrey"
          position: "30,971"
          render: "Progress"
          size: "1860,10"
          source: "Service"
          transparent: "1"
          zPosition: "3"
          children:
            - convert:
                type: "COCBeforeTSPosition"
                text: "Position"
      - widget:
          alphatest: "blend"
          foregroundColor: "red"
          position: "30,971"
          render: "Progress"
          size: "1860,10"
          source: "Service"
          transparent: "1"
          zPosition: "1"
          children:
            - convert:
                type: "COCRecordPosition"
                text: "Position"
