screen:
  name: "BufferingProgressSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_fonts.ymlinc"
    - ePixmap:
        pixmap: "~/../images/display_bg.png"
        position: "0,0"
        size: "400,240"
        zPosition: "-1"
    - widget:
        name: "lcd_pic"
        position: "150,70"
        size: "100,100"
        transparent: "1"
