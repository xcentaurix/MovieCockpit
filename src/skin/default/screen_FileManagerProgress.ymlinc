screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "FileManagerProgress"
  position: "center,center"
  resolution: "1920,1080"
  size: "1200,410"
  children:
    - xmlinc:
        file: "screenpart_fonts.noymlinc"
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "operation"
        position: "20,75"
        size: "1160,43"
        transparent: "1"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "name"
        position: "20,136"
        size: "1160,43"
        transparent: "1"
    - widget:
        name: "slider1"
        position: "20,197"
        size: "1160,25"
        transparent: "1"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "status"
        position: "20,240"
        size: "1160,43"
        transparent: "1"
    - widget:
        font: "$FR_medium"
        halign: "left"
        position: "20,301"
        render: "Label"
        size: "1160,35"
        source: "DiskSpace"
        transparent: "1"
        children:
          - convert:
              type: "COCDiskSpaceInfo"
              text: "SpaceInfo"
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
